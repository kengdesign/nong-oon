{
  "name": "nong-oon-load-review",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "account_id": "c5f673e7bdf271485603029e19f42f49",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 50 },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_ENV": "isolated-load-review", "DELIVERY_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "nong-oon-load-review",
    "database_id": "ac1922cf-38d7-40ce-8dfd-9a01703c5035", "migrations_dir": "../migrations" }],
  "durable_objects": { "bindings": [{ "name": "PATIENT_CLOCK", "class_name": "LoadPatientClock" }] },
  "migrations": [{ "tag": "v1-load-clock", "new_sqlite_classes": ["LoadPatientClock"] }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 } }
}
