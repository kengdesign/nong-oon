{
  "name": "nong-oon-staging",
  "main": "src/webhook.mjs",
  "compatibility_date": "2026-10-25",
  "account_id": "c5f673e7bdf271485603029e19f42f49",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 50
  },
  "triggers": {
    "crons": [
      "17 * * * *",
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/webhook/*",
      "/health",
      "/auth/*",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nong-oon-staging",
      "database_id": "9a584c89-3b1f-4ae6-9b59-f97d1b75946d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PATIENT_CLOCK",
        "class_name": "PatientClock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-patient-clock",
      "new_sqlite_classes": [
        "PatientClock"
      ]
    }
  ],
  "keep_vars": true
}
